import { HostState, MaintenanceState } from "host-state.slint";
import { Theme, ActivityFill, Label, Action, Panel, SectionTitle } from "components.slint";
export component MaintenancePage inherits VerticalLayout {
    in property <float> entrance: 1;
    spacing: 12px;
    Panel { height: update-content.preferred-height + 40px; entrance: root.entrance;
        update-content := VerticalLayout { x: 21px; y: 20px; width: parent.width - 42px; height: self.preferred-height; spacing: 14px;
            Rectangle { height: 64px;
                SectionTitle { x: 0px; y: 0px; height: 26px; text: "软件更新"; }
                Label { x: 0px; y: 32px; width: parent.width - 180px; height: 32px; text: MaintenanceState.current-version; font-size: 22px; font-weight: 700; }
                Action { x: parent.width - 150px; y: 30px; width: 150px; height: 34px; busy: MaintenanceState.busy; label: MaintenanceState.busy ? "正在处理…" : "检查更新"; enabled: MaintenanceState.attached && !MaintenanceState.busy; clicked => { MaintenanceState.action("check"); } }
            }
            if MaintenanceState.update-status != "": Label { width: parent.width; height: self.preferred-height; text: MaintenanceState.update-status; wrap: word-wrap; color: MaintenanceState.installable ? Theme.blue : Theme.muted; font-size: 13px; }
            if MaintenanceState.installable && MaintenanceState.update-notes != "": Rectangle {
                height: notes.preferred-height + 24px; background: Theme.background; border-radius: 6px;
                notes := Label { x: 12px; y: 12px; width: parent.width - 24px; height: self.preferred-height; wrap: word-wrap; text: MaintenanceState.update-notes; color: Theme.ivory; font-size: 12px; }
            }
            if MaintenanceState.installable: HorizontalLayout { height: 38px; spacing: 16px;
                Action { width: 150px; horizontal-stretch: 0; primary: true; label: "更新并重启"; enabled: !MaintenanceState.busy; clicked => { MaintenanceState.action("install"); } }
                Label { text: "下载完成后自动更新并重启。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            }
        }
        if MaintenanceState.updating: ActivityFill { x: 1px; y: parent.height - 5px; width: parent.width - 2px; height: 4px; active: true; fraction: MaintenanceState.update-fraction; }
    }
    Action { label: MaintenanceState.storage-open ? "收起存储管理" : "存储管理"; clicked => { MaintenanceState.storage-open = !MaintenanceState.storage-open; } }
    if MaintenanceState.storage-open: Panel { height: storage-content.preferred-height + 40px; entrance: root.entrance; entrance-group: 1;
        storage-content := VerticalLayout { x: 21px; y: 20px; width: parent.width - 42px; height: self.preferred-height; spacing: 14px;
            SectionTitle { height: 26px; text: "存储管理"; }
            if MaintenanceState.storage-summary != "": Label { width: parent.width; height: self.preferred-height; wrap: word-wrap; text: MaintenanceState.storage-summary; color: Theme.muted; font-size: 12px; }
            if MaintenanceState.storage-rows.length > 0: VerticalLayout { height: MaintenanceState.storage-rows.length * 30px; spacing: 0px;
                for row in MaintenanceState.storage-rows: Label { height: 30px; text: row; font-size: 13px; }
            }
            HorizontalLayout { height: 36px; spacing: 10px;
                Action { label: "扫描本地占用"; enabled: MaintenanceState.attached && !MaintenanceState.busy; clicked => { MaintenanceState.action("scan"); } }
                if MaintenanceState.can-clean: Action { label: "清理可回收文件"; enabled: !MaintenanceState.busy && !HostState.running; clicked => { MaintenanceState.action("clean"); } }
            }
        }
    }
}
export component MaintenanceConfirm inherits Rectangle {
    in property <bool> opened: MaintenanceState.confirmation != "";
    out property <bool> cancel-focused: cancel.focused;
    visible: root.opened;
    background: #000000b8;
    changed opened => { if root.opened { cancel.focus(); } }
    TouchArea { clicked => { MaintenanceState.action("cancel"); } }
    FocusScope { focus-on-click: false; enabled: root.opened;
        key-pressed(event) => {
            if event.text == Key.Escape { MaintenanceState.action("cancel"); return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab { if cancel.focused { confirm.focus(); } else { cancel.focus(); } return accept; }
            return reject;
        }
        Panel { x: (root.width - 420px)/2; y: (root.height - self.height)/2; width: 420px; height: MaintenanceState.confirmation == "available" ? min(420px, max(260px, note.preferred-height + 138px)) : 238px;
            TouchArea { }
            SectionTitle { x: 24px; y: 20px; height: 26px; text: MaintenanceState.confirmation == "clean" ? "确认清理" : MaintenanceState.confirmation == "forget" ? "移除旧更新令牌" : "发现新版本"; }
            Flickable { x: 24px; y: 62px; width: 372px; height: parent.height - 138px; viewport-width: self.width; viewport-height: note.preferred-height;
            note := Label { width: 372px; height: self.preferred-height; wrap: word-wrap; text: MaintenanceState.confirmation == "available" ? "当前版本 " + MaintenanceState.current-version + "\n" + MaintenanceState.update-status + "\n\n" + MaintenanceState.update-notes : MaintenanceState.confirmation == "clean" ? MaintenanceState.storage-summary + "\n仅清理已预览的过期文件；保留个人记录、设置、当前数据和回滚数据。" : MaintenanceState.confirmation == "forget" ? "删除此电脑上保存的旧更新授权？" : "下载完成后将更新 FUZE，并自动打开新版。\n设置和个人记录会保留。"; color: Theme.muted; }
            }
            HorizontalLayout { x: parent.width - 254px; y: parent.height - 58px; width: 230px; height: 38px; spacing: 10px;
                cancel := Action { label: "取消"; enabled: root.opened; clicked => { MaintenanceState.action("cancel"); } }
                confirm := Action { description: MaintenanceState.confirmation == "available" ? "安装此更新并重启" : self.label; label: MaintenanceState.confirmation == "available" ? "更新并重启" : "确认"; primary: true; enabled: root.opened; clicked => { MaintenanceState.action(MaintenanceState.confirmation == "available" ? "install" : "confirm"); } }
            }
        }
    }
}
