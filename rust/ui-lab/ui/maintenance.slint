import { HostState, MaintenanceState } from "host-state.slint";
import { Theme, Label, Action, Panel, SectionTitle } from "components.slint";
export component MaintenancePage inherits VerticalLayout {
    in property <float> entrance: 1;
    spacing: 12px;
    Panel { height: 210px + (MaintenanceState.installable ? notes.preferred-height + 12px : 0px); entrance: root.entrance;
        SectionTitle { x: 23px; y: 18px; height: 26px; text: "软件更新"; }
        Label { x: 160px; y: 18px; width: parent.width - 183px; height: 26px; text: "当前版本 · " + MaintenanceState.current-version; horizontal-alignment: right; color: Theme.muted; }
        Label { x: 23px; y: 57px; width: parent.width - 46px; height: 44px; text: MaintenanceState.update-status; wrap: word-wrap; color: Theme.muted; }
        notes := Label { visible: MaintenanceState.installable; x: 23px; y: 108px; width: parent.width - 46px; height: self.preferred-height; wrap: word-wrap; text: MaintenanceState.update-notes; color: Theme.ivory; font-size: 12px; }
        Action { x: 23px; y: parent.height - 94px; width: 150px; busy: MaintenanceState.busy; label: MaintenanceState.busy ? "正在处理…" : "检查新版"; enabled: MaintenanceState.attached && !MaintenanceState.busy; clicked => { MaintenanceState.action("check"); } }
        if MaintenanceState.installable: Action { x: 185px; y: parent.height - 94px; width: parent.width - 208px; label: "更新并重启"; enabled: !MaintenanceState.busy; clicked => { MaintenanceState.action("install"); } }
        Label { x: 23px; y: parent.height - 44px; width: parent.width - 46px; height: 28px; wrap: word-wrap; text: "下载期间可继续使用，完成后自动停止识别、更新并重启。"; color: Theme.muted; font-size: 12px; }
    }
    if MaintenanceState.notice != "" && MaintenanceState.notice != MaintenanceState.update-status: Label { height: 46px; text: MaintenanceState.notice; wrap: word-wrap; color: Theme.yellow; }
    Action { label: MaintenanceState.storage-open ? "收起存储管理" : "存储管理"; clicked => { MaintenanceState.storage-open = !MaintenanceState.storage-open; } }
    if MaintenanceState.storage-open: Panel { height: 190px + MaintenanceState.storage-rows.length * 30px; entrance: root.entrance; entrance-group: 1;
        SectionTitle { x: 23px; y: 18px; height: 26px; text: "存储管理"; }
        Label { x: 23px; y: 55px; width: parent.width - 46px; height: 48px; wrap: word-wrap; text: MaintenanceState.storage-summary; color: Theme.muted; }
        VerticalLayout { x: 23px; y: 112px; width: parent.width - 46px; height: MaintenanceState.storage-rows.length * 30px; spacing: 0px;
            for row in MaintenanceState.storage-rows: Label { height: 30px; text: row; font-size: 12px; }
        }
        HorizontalLayout { x: 23px; y: parent.height - 55px; width: 280px; height: 36px; spacing: 10px;
            Action { label: "扫描本地占用"; enabled: MaintenanceState.attached && !MaintenanceState.busy && !HostState.running; clicked => { MaintenanceState.action("scan"); } }
            Action { label: "清理可回收文件"; enabled: MaintenanceState.can-clean && !MaintenanceState.busy && !HostState.running; clicked => { MaintenanceState.action("clean"); } }
        }
    }
}
export component MaintenanceConfirm inherits Rectangle {
    in property <bool> opened: MaintenanceState.confirmation != "";
    out property <bool> cancel-focused: cancel.focused;
    visible: root.opened;
    background: #000000b8;
    changed opened => { if root.opened { cancel.focus(); } }
    TouchArea { clicked => { MaintenanceState.action("cancel"); } }
    FocusScope { focus-on-click: false; enabled: root.opened;
        key-pressed(event) => {
            if event.text == Key.Escape { MaintenanceState.action("cancel"); return accept; }
            if event.text == Key.Tab || event.text == Key.Backtab { if cancel.focused { confirm.focus(); } else { cancel.focus(); } return accept; }
            return reject;
        }
        Panel { x: (root.width - 420px)/2; y: (root.height - self.height)/2; width: 420px; height: MaintenanceState.confirmation == "available" ? min(420px, max(260px, note.preferred-height + 138px)) : 238px;
            TouchArea { }
            SectionTitle { x: 24px; y: 20px; height: 26px; text: MaintenanceState.confirmation == "clean" ? "确认清理" : MaintenanceState.confirmation == "forget" ? "移除旧更新令牌" : "发现新版本"; }
            Flickable { x: 24px; y: 62px; width: 372px; height: parent.height - 138px; viewport-width: self.width; viewport-height: note.preferred-height;
            note := Label { width: 372px; height: self.preferred-height; wrap: word-wrap; text: MaintenanceState.confirmation == "available" ? "当前版本 " + MaintenanceState.current-version + "\n" + MaintenanceState.update-status + "\n\n" + MaintenanceState.update-notes : MaintenanceState.confirmation == "clean" ? MaintenanceState.storage-summary + "\n仅清理已预览的过期文件；保留个人记录、设置、当前数据和回滚数据。" : MaintenanceState.confirmation == "forget" ? "公开更新已无需令牌。这里只删除旧更新凭据，反馈上传的独立令牌和本地推荐均保留。" : "将退出 FUZE，下载并覆盖当前程序，完成后自动打开新版。\n设置和个人记录会保留。"; color: Theme.muted; }
            }
            HorizontalLayout { x: parent.width - 254px; y: parent.height - 58px; width: 230px; height: 38px; spacing: 10px;
                cancel := Action { label: "取消"; enabled: root.opened; clicked => { MaintenanceState.action("cancel"); } }
                confirm := Action { description: MaintenanceState.confirmation == "available" ? "安装此更新并重启" : self.label; label: MaintenanceState.confirmation == "available" ? "更新并重启" : "确认"; primary: true; enabled: root.opened; clicked => { MaintenanceState.action(MaintenanceState.confirmation == "available" ? "install" : "confirm"); } }
            }
        }
    }
}
