// Public synthetic content for deterministic offscreen motion acceptance only.
import { Theme, UiMotion, StatusSurface, PageEntrance, Panel, Label, Tabs, Disclosure } from "components.slint";
export component MotionReview inherits Window {
    width: 640px; height: 448px; background: Theme.background;
    default-font-family: "Microsoft YaHei UI"; default-font-size: 13px;
    in-out property <int> health: 0;
    in-out property <int> page: 0;
    in-out property <bool> expanded: false;
    out property <float> sweep-progress: status.progress;
    out property <float> entrance-progress: entrance.progress;
    out property <float> tab-indicator: tabs.indicator-x / 1px;
    out property <float> chevron-progress: disclosure.chevron-progress;
    out property <string> status-text: root.health == 3 ? "连接异常 · 等待重试" : root.health == 2 ? "部分卡位暂不可读" : root.health == 1 ? "识别正常 · 推荐已就绪" : "正在准备";
    entrance := PageEntrance { page: root.page; }
    tabs := Tabs { x: 16px; y: 8px; width: 608px; labels: ["常用设置", "数据与更新", "帮助与反馈"]; current <=> root.page; }
    status := StatusSurface {
        x: 16px; y: 66px; width: 608px; height: 146px;
        fill: root.health == 0 ? #12324b : root.health == 1 ? #123d34 : root.health == 2 ? #49391b : #4b222b;
        accent: root.health == 0 ? Theme.blue : root.health == 1 ? Theme.green : root.health == 2 ? Theme.yellow : Theme.red;
        Label { x: 24px; y: 18px; text: "实时状态 · 离线动效样例"; color: Theme.gold; }
        Label { x: 24px; y: 48px; text: root.status-text; font-size: 22px; font-weight: 600; }
        Label { x: 24px; y: 101px; text: "固定样例，不连接客户端或启动识别。"; color: Theme.muted; }
    }
    HorizontalLayout { x: 16px; y: 228px; width: 608px; height: 76px; spacing: 12px;
        for name[index] in ["客户端连接", "中文识别", "推荐数据"]: Panel {
            entrance: entrance.progress; entrance-group: index;
            Label { x: 12px; y: 10px; text: name; color: Theme.gold; }
            Label { x: 12px; y: 40px; text: "公开样例 · 可立即读取"; color: Theme.muted; font-size: 12px; }
        }
    }
    disclosure := Disclosure { x: 16px; y: 320px; width: 608px; expanded <=> root.expanded; label: "运行详情"; detail: "点击展开时，文字立即出现，箭头短暂旋转。"; }
}
