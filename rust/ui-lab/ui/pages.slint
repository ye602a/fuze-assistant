import { Theme, Label, Action, Panel, SectionTitle, Disclosure } from "components.slint";

export component SettingsPage inherits VerticalLayout {
    // Rendering restoration only. Mutations stay disabled until the Rust host is connected.
    spacing: 18px;
    Panel {
        height: 280px;
        Label { x: 23px; y: 21px; height: 20px; text: "软件更新"; color: Theme.gold; font-size: 15px; }
        Label { x: 23px; y: 56px; height: 30px; text: "当前版本 — · 尚未连接更新服务"; font-size: 19px; }
        Label { x: 23px; y: 100px; width: parent.width - 46px; height: 50px; wrap: word-wrap; text: "优先增量下载，缓存缺失或差分不可用时下载完整包。\n下载和安装均由你决定，不会退出游戏。"; color: Theme.muted; }
        HorizontalLayout { x: 23px; y: 164px; width: 240px; height: 38px; spacing: 10px;
            Action { label: "检查新版"; enabled: false; }
            Action { label: "发布记录"; enabled: false; }
        }
        Label { x: 23px; y: 224px; width: parent.width - 46px; height: 34px; wrap: word-wrap; text: "私有频道授权由现有 Rust 安全存储管理；此预览不读取或保存令牌。"; color: Theme.muted; font-size: 11px; }
    }
    Disclosure { label: "存储管理"; detail: "保留个人记录、设置、当前与回滚版本。\n连接宿主后先预览，再确认清理；离线预览不扫描文件。"; }
    Panel {
        height: 660px;
        VerticalLayout { x: 21px; y: 5px; width: parent.width - 42px; height: 640px; spacing: 0px;
            for pref in [
                {name:"自动识别强化符文",hint:"仅在对局阶段检测，空闲时停止截图。"},
                {name:"按强化等级节省识别开销",hint:"等级读取失败会恢复基础检测，不据此推断实际领取轮次。"},
                {name:"GPU 加速识别",hint:"选人时预热；识别后端异常时使用已有 CPU 回退。"},
                {name:"顶部三卡推荐",hint:"按实际卡位展示；暂不可读时保留位置和提示。"},
                {name:"局内海克斯侧栏",hint:"按需查看符文池与详情，不自动操作游戏。"},
                {name:"选人英雄详情",hint:"我方五人在顶部，候选英雄按胜率网格一览。"},
                {name:"选人阶段窗口置顶",hint:"仅影响助手窗口，不改变游戏设置。"},
                {name:"界面与数据语言",hint:"简体中文"}
            ]: Rectangle {
                Rectangle { x: 0px; y: parent.height - 1px; height: 1px; background: Theme.stroke; }
                Label { x: 0px; y: 15px; height: 24px; text: pref.name; font-size: 13px; }
                Label { x: 0px; y: 43px; width: parent.width - 160px; height: 26px; wrap: word-wrap; text: pref.hint; color: Theme.muted; font-size: 11px; }
                Label { x: parent.width - 125px; y: 24px; width: 125px; height: 30px; text: "等待读取设置"; horizontal-alignment: right; color: Theme.muted; font-size: 11px; }
            }
        }
    }
    Panel { height: 74px;
        Label { x: 21px; y: 12px; height: 23px; text: "浮窗显示"; color: Theme.blue; }
        Label { x: 21px; y: 38px; width: parent.width - 42px; height: 25px; text: "独占全屏可能遮住桌面浮窗，需要显示时可在游戏中自行选择无边框或窗口模式。"; wrap: word-wrap; color: Theme.muted; font-size: 11px; }
    }
    Panel { height: 300px;
        SectionTitle { x: 21px; y: 18px; height: 28px; text: "连接与诊断"; }
        Label { x: 21px; y: 58px; height: 24px; text: "自动识别并连接客户端"; }
        Label { x: 21px; y: 91px; width: parent.width - 42px; height: 38px; text: "登录后自动发现，无需选择安装目录。目录识别不等于通信成功，以实际连接状态为准。"; wrap: word-wrap; color: Theme.muted; font-size: 11px; }
        Label { x: 21px; y: 138px; height: 20px; text: "离线预览未访问客户端"; color: Theme.blue; font-size: 11px; }
        Disclosure { x: 21px; y: 174px; width: parent.width - 42px; label: "高级回退：自动连接失败时手动指定目录"; detail: "目录操作接回宿主后启用，不把手动路径当作自动发现成功。"; }
    }
    Panel { height: 215px;
        SectionTitle { x: 21px; y: 18px; height: 28px; text: "领取轮次验证"; }
        Label { x: 21px; y: 58px; width: parent.width - 42px; height: 44px; text: "实际领取轮次尚未确认，继续使用整体胜率。\n刷新、属性碎片和锻造器额外选择不计为正式轮次。"; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout { x: 21px; y: 123px; width: 360px; height: 38px; spacing: 10px;
            Action { label: "打开本地日志"; enabled: false; }
            Action { label: "预览推荐浮窗"; enabled: false; }
            Action { label: "检查一次"; enabled: false; }
        }
        Label { x: 21px; y: 176px; height: 23px; text: "此预览仅恢复布局，诊断操作尚未接回宿主。"; color: Theme.muted; font-size: 11px; }
    }
}

export component HistoryPage inherits VerticalLayout {
    in property <bool> sample: false;
    spacing: 18px;
    Panel { height: 220px;
        SectionTitle { x: 21px; y: 18px; height: 26px; text: "海克斯大乱斗战绩"; }
        Label { x: 21px; y: 53px; width: parent.width - 150px; height: 24px; text: "自己的海克斯对局，优先显示本地记录；登录客户端后可补充最新战绩。"; color: Theme.muted; wrap: word-wrap; }
        Action { x: parent.width - 110px; y: 20px; width: 88px; label: "刷新战绩"; enabled: false; }
        Disclosure { x: 21px; y: 100px; width: parent.width - 42px; label: "本地选择记录 · 观察不等于领取"; detail: "按已确认账号与区服隔离显示。未归属的旧观察记录不自动算入当前账号。"; }
        if !root.sample: Label { x: 21px; y: 168px; width: parent.width - 42px; height: 30px; text: "此预览未读取账号或战绩缓存。业务接回宿主后再查询，不猜测区服。"; color: Theme.yellow; wrap: word-wrap; }
    }
    if root.sample: VerticalLayout {
        spacing: 12px;
        Label { text: "固定界面样例 · 非个人战绩"; color: Theme.yellow; height: 24px; }
        for match in [
            {hero:"格温",result:"胜利",kda:"8 / 3 / 15",tone:Theme.green},
            {hero:"深海泰坦",result:"失败",kda:"3 / 7 / 22",tone:Theme.red}
        ]: Panel {
            height: 130px;
            Image { x: 21px; y: 27px; width: 43px; height: 43px; source: @image-url("assets/rune.svg"); }
            SectionTitle { x: 80px; y: 21px; width: 240px; height: 30px; text: match.hero; }
            Label { x: 80px; y: 58px; height: 23px; text: "海克斯大乱斗 · 固定示例"; color: Theme.muted; font-size: 11px; }
            Label { x: parent.width - 260px; y: 25px; height: 28px; text: match.result; color: match.tone; font-size: 18px; }
            Label { x: parent.width - 170px; y: 25px; height: 28px; text: match.kda; font-size: 20px; }
            Label { x: 21px; y: 95px; width: parent.width - 42px; height: 20px; text: "装备、符文、战绩详情与分享将使用已有 Rust 数据；此处不虚构已领取符文。"; color: Theme.muted; font-size: 11px; }
        }
    }
}
