import { MaintenancePage } from "maintenance.slint";
import { ComboBox, LineEdit } from "std-widgets.slint";
import { HostState, ShellState, RecordState, DiagnosticState, MaintenanceState } from "host-state.slint";
import { RecordDetails, RecordLayout } from "records.slint";
import { Theme, ActivityFill, Label, Action, Panel, SectionTitle, Toggle, Tabs } from "components.slint";

export component SettingsPage inherits VerticalLayout {
    in property <float> entrance: 1;
    in-out property <int> section: 0;
    in-out property <bool> migration-open: false;
    in-out property <bool> manual-open: false;
    in-out property <bool> feedback-open: false;
    spacing: 16px;
    Tabs { labels: ["常用设置", "数据与更新", "帮助与反馈"]; current <=> root.section; }
    if root.section == 0: VerticalLayout { spacing: 16px;
        Panel {
            height: preferences-content.preferred-height + 70px;
            SectionTitle { x: 21px; y: 16px; height: 26px; text: "识别与显示"; }
            preferences-content := VerticalLayout {
                x: 21px; y: 50px; width: parent.width - 42px; height: self.preferred-height; spacing: 0px;
                for pref in HostState.preferences: Rectangle {
                    height: pref.hint == "" && pref.key != "pause_hotkey" && pref.key != "close_to_tray" ? 48px : 64px;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.stroke; opacity: 0.45; }
                    Label { x: 0px; y: 6px; width: parent.width - 75px; height: 24px; text: pref.title; font-size: 14px; font-weight: 600; }
                    if pref.hint != "" || pref.key == "pause_hotkey" || pref.key == "close_to_tray": Label {
                        x: 0px; y: 31px; width: parent.width - 75px; height: 28px; wrap: word-wrap;
                        text: ShellState.attached && pref.key == "pause_hotkey" ? ShellState.hotkey-hint : ShellState.attached && pref.key == "close_to_tray" ? ShellState.tray-hint : pref.hint;
                        color: Theme.muted; font-size: 12px;
                    }
                    Toggle { x: parent.width - 44px; y: (parent.height - self.height) / 2; label: pref.title; checked: pref.checked; enabled: HostState.connected && !HostState.busy; toggled => { HostState.preference(pref.key, !pref.checked); } }
                }
                Rectangle { height: 58px;
                    Label { x: 0px; y: 12px; width: parent.width - 250px; height: 34px; text: "识别方式"; font-weight: 600; }
                    ComboBox { accessible-label: "识别后端"; x: parent.width - 235px; y: 12px; width: 235px; height: 34px; model: ["自动选择（GPU 优先）", "CPU", "DirectML（GPU）"]; current-index <=> HostState.backend; enabled: HostState.connected && !HostState.busy; selected(value) => { HostState.backend-changed(self.current-index); } }
                }
            }
        }
        Panel { height: 110px;
            SectionTitle { x: 21px; y: 17px; height: 26px; text: "局内浮窗"; }
            Action { x: parent.width - 186px; y: 17px; width: 165px; height: 32px; label: "重新打开局内资料"; enabled: HostState.connected; clicked => { HostState.command("show-reference"); } }
            Label { x: 21px; y: 61px; width: parent.width - 42px; height: 32px; text: "浮窗被全屏游戏遮住时，请切换为无边框或窗口模式。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
        }
        Panel { height: root.manual-open ? 308px : 154px;
            SectionTitle { x: 21px; y: 17px; height: 28px; text: "客户端连接"; }
            Label { x: 21px; y: 53px; width: parent.width - 42px; height: 24px; text: HostState.offline ? "离线预览" : HostState.connection-value; color: HostState.connection-tone == 3 ? Theme.red : HostState.connection-tone == 2 ? Theme.yellow : Theme.muted; }
            Label { x: 21px; y: 83px; width: parent.width - 42px; height: 22px; text: "打开英雄联盟客户端后自动连接。"; color: Theme.muted; font-size: 12px; }
            Action { x: 21px; y: 114px; width: 164px; height: 30px; label: root.manual-open ? "收起手动目录" : "手动指定目录"; clicked => { root.manual-open = !root.manual-open; } }
            if root.manual-open: VerticalLayout { x: 21px; y: 164px; width: parent.width - 42px; height: 124px; spacing: 10px;
                Label { text: "选择包含 LeagueClient.exe 的目录；留空使用自动连接。"; color: Theme.muted; height: 24px; font-size: 12px; }
                LineEdit { accessible-label: "客户端目录"; text <=> HostState.directory; enabled: HostState.connected && !HostState.busy; placeholder-text: "客户端目录"; height: 36px; }
                HorizontalLayout { height: 36px; spacing: 10px;
                    Action { primary: true; busy: HostState.pending-action == "directory"; label: HostState.pending-action == "directory" ? "正在保存…" : "保存目录"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.directory-save(HostState.directory); } }
                    Action { label: "恢复自动连接"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.directory-save(""); } }
                }
            }
        }
    }
    if root.section == 1: VerticalLayout { spacing: 16px;
        if HostState.running && (root.migration-open || MaintenanceState.storage-open): Panel { height: 68px;
            Label { x: 21px; y: 17px; width: parent.width - 204px; height: 34px; text: "清理文件或导入设置前，请暂停识别。"; wrap: word-wrap; color: Theme.muted; }
            Action { x: parent.width - 165px; y: 17px; width: 144px; height: 34px; label: "暂停识别"; description: "暂停并管理"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.command("toggle-running"); } }
        }
        Panel {
            height: 108px + (HostState.data-mismatch && HostState.data-compatibility != "" ? 44px : 0px) + (HostState.data-progress != "" ? 42px : 0px);
            SectionTitle { x: 21px; y: 17px; height: 26px; text: "推荐数据"; }
            if HostState.data-version != "" && HostState.data-version != "—": Label { x: 21px; y: 55px; width: parent.width - 232px; height: 30px; text: HostState.data-version; font-size: 20px; font-weight: 700; }
            Action { x: parent.width - 191px; y: 53px; width: 170px; height: 34px; busy: HostState.pending-action == "data-update"; label: HostState.pending-action == "data-update" ? "正在更新…" : "检查数据更新"; enabled: HostState.connected && !HostState.offline && !HostState.busy; clicked => { HostState.command("data-update"); } }
            if HostState.data-mismatch && HostState.data-compatibility != "": Label { x: 21px; y: 98px; width: parent.width - 42px; height: 36px; text: HostState.data-compatibility; wrap: word-wrap; color: Theme.yellow; font-size: 12px; }
            if HostState.data-progress != "": Label { x: 21px; y: 98px + (HostState.data-mismatch && HostState.data-compatibility != "" ? 44px : 0px); width: parent.width - 42px; height: 34px; text: HostState.data-progress; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            if HostState.pending-action == "data-update": ActivityFill {
                x: 1px; y: parent.height - 5px; width: parent.width - 2px; height: 4px; active: true;
                fraction: HostState.data-total > 0 ? 1.0 * HostState.data-completed / HostState.data-total : -1;
            }
        }
        MaintenancePage { entrance: root.entrance; }
        Action { label: root.migration-open ? "收起旧设置迁移" : "旧设置迁移"; clicked => { root.migration-open = !root.migration-open; } }
        if root.migration-open: Panel { height: 130px;
            SectionTitle { x: 21px; y: 17px; height: 25px; text: "迁移旧版偏好"; }
            Label { x: 21px; y: 51px; width: parent.width - 42px; height: 27px; text: "选择旧配置，预览并确认后导入可兼容的设置。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            Action { x: 21px; y: 88px; width: 165px; height: 30px; label: "选择旧设置并预览"; enabled: HostState.connected && !HostState.busy && !HostState.running && !HostState.offline; clicked => { RecordState.action("import-settings",0); } }
        }
    }
    if root.section == 2: VerticalLayout { spacing: 16px;
        Panel { height: diagnostic-content.preferred-height + 40px;
            diagnostic-content := VerticalLayout { x: 21px; y: 20px; width: parent.width - 42px; height: self.preferred-height; spacing: 14px;
                SectionTitle { height: 26px; text: "本地诊断"; }
                if DiagnosticState.summary != "": Label { width: parent.width; height: self.preferred-height; text: DiagnosticState.summary; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
                HorizontalLayout { height: 36px; spacing: 10px;
                    Action { label: DiagnosticState.open ? "收起最近状态" : "查看最近状态"; clicked => { DiagnosticState.open = !DiagnosticState.open; } }
                    Action { busy: DiagnosticState.busy; label: DiagnosticState.busy ? "正在导出…" : "导出脱敏反馈"; enabled: HostState.connected && !HostState.running && !HostState.busy && !DiagnosticState.busy; clicked => { DiagnosticState.action("export"); } }
                    Action { label: "打开日志目录"; enabled: HostState.connected && !HostState.offline; clicked => { DiagnosticState.action("open-logs"); } }
                    if DiagnosticState.log-retry: Action { label: "重试日志"; enabled: !DiagnosticState.busy; clicked => { DiagnosticState.action("retry-log"); } }
                }
                if DiagnosticState.log-status != "": Label { width: parent.width; height: self.preferred-height; text: DiagnosticState.log-status; wrap: word-wrap; color: DiagnosticState.log-retry ? Theme.yellow : Theme.muted; font-size: 12px; }
                Label { width: parent.width; height: self.preferred-height; text: HostState.running ? "导出前请暂停识别。反馈文件保存在本地，不会自动上传。" : "反馈文件保存在本地，不会自动上传。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
                if DiagnosticState.open && DiagnosticState.rows.length > 0: VerticalLayout { spacing: 8px;
                    for row in DiagnosticState.rows: Rectangle {
                        height: status-row.preferred-height + 20px; background: Theme.background; border-radius: 6px;
                        status-row := Label { x: 10px; y: 10px; width: parent.width - 20px; height: self.preferred-height; text: row; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
                    }
                }
            }
        }
        Panel { height: screenshots-content.preferred-height + 40px;
            screenshots-content := VerticalLayout { x: 21px; y: 20px; width: parent.width - 42px; height: self.preferred-height; spacing: 14px;
                Rectangle { height: 28px;
                    SectionTitle { width: parent.width - 80px; height: 28px; text: "本地识别截图"; }
                    Toggle { x: parent.width - 44px; y: 1px; label: "本次运行记录识别截图"; checked: DiagnosticState.screenshots-enabled; enabled: HostState.connected && !HostState.offline; toggled => { DiagnosticState.action("toggle-screenshots"); } }
                }
                Label { width: parent.width; height: self.preferred-height; text: "仅在本地保存三卡标题、按钮与识别状态，不录全屏、不自动上传。上限 1200 条 / 256 MiB；分享前请检查图片。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
                if DiagnosticState.screenshots-status != "": Label { width: parent.width; height: self.preferred-height; text: DiagnosticState.screenshots-status; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
                HorizontalLayout { height: 32px; spacing: 10px;
                    Action { label: "标记最近画面有问题"; enabled: DiagnosticState.screenshots-recent && !HostState.offline; clicked => { DiagnosticState.action("mark-screenshot"); } }
                    Action { label: "打开截图目录"; enabled: HostState.connected && !HostState.offline; clicked => { DiagnosticState.action("open-screenshots"); } }
                }
            }
        }
        Action { label: root.feedback-open ? "收起公开诊断反馈" : "展开公开诊断反馈"; clicked => { root.feedback-open = !root.feedback-open; } }
        if root.feedback-open: Panel { height: 488px + (DiagnosticState.upload-notice != "" ? 52px : 0px) + (DiagnosticState.upload-confirm ? 100px : 0px);
            SectionTitle { x: 21px; y: 18px; height: 28px; text: "GitHub 公开诊断反馈"; }
            Label { x: 21px; y: 58px; width: parent.width - 110px; height: 38px; text: "赛后报告 · 识别异常快照"; wrap: word-wrap; }
            Toggle { x: parent.width - 65px; y: 62px; label: "每局自动上传到公开 Issues"; checked: DiagnosticState.upload-enabled; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; toggled => { DiagnosticState.upload-action("toggle"); } }
            Label { x: 21px; y: 103px; width: parent.width - 42px; height: 40px; text: DiagnosticState.upload-tracking; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            Label { x: 21px; y: 149px; width: parent.width - 42px; height: 54px; text: DiagnosticState.upload-status; wrap: word-wrap; color: Theme.blue; font-size: 12px; }
            Label { x: 21px; y: 209px; width: parent.width - 42px; height: 40px; text: DiagnosticState.upload-authorization; wrap: word-wrap; color: Theme.gold; font-size: 12px; }
            HorizontalLayout { x: 21px; y: 263px; width: parent.width - 42px; height: 36px; spacing: 10px;
                Action { label: "获取上传令牌"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("help"); } }
                Action { label: "配置上传令牌"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("configure"); } }
                Action { label: DiagnosticState.upload-busy ? "正在验证…" : "验证授权"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("verify"); } }
            }
            HorizontalLayout { x: 21px; y: 311px; width: parent.width - 42px; height: 36px; spacing: 10px;
                Action { label: "补传最近对局"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy && !HostState.running; clicked => { DiagnosticState.upload-confirm = true; } }
                Action { label: "重试待传报告"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("retry"); } }
                Action { label: "查看报告"; enabled: DiagnosticState.upload-has-report; clicked => { DiagnosticState.upload-action("open"); } }
            }
            Action { x: 21px; y: 359px; width: 170px; label: "删除上传令牌"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("remove"); } }
            if DiagnosticState.upload-notice != "": Label { x: 21px; y: 404px; width: parent.width - 42px; height: 48px; text: DiagnosticState.upload-notice; wrap: word-wrap; font-size: 12px; color: Theme.gold; }
            Label { x: 21px; y: 409px + (DiagnosticState.upload-notice != "" ? 52px : 0px); width: parent.width - 42px; height: 66px; text: "报告公开在 ye602a/fuze-assistant 的 Issues。仅上传状态、耗时、计数和卡位分类，不含截图、账号、路径、OCR 原文或密钥。\n上传反馈需要 GitHub Issues 读写授权。暂停后可补传最近对局的报告。"; wrap: word-wrap; font-size: 12px; color: Theme.muted; }
            if DiagnosticState.upload-confirm: Rectangle { x: 21px; y: 483px + (DiagnosticState.upload-notice != "" ? 52px : 0px); width: parent.width - 42px; height: 88px; background: transparent;
                Label { x: 0px; y: 0px; width: parent.width; height: 38px; text: "将从本地有限日志生成最近对局摘要并公开上传；可能不完整，不会上传原始日志。"; wrap: word-wrap; font-size: 12px; }
                HorizontalLayout { y: 46px; width: parent.width; height: 34px; spacing: 10px;
                    Action { label: "取消"; clicked => { DiagnosticState.upload-confirm = false; } }
                    Action { primary: true; label: "确认公开补传"; enabled: !HostState.running && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-confirm = false; DiagnosticState.upload-action("recover"); } }
                }
            }
        }
    }
}

export component HistoryPage inherits VerticalLayout {
    in property <float> entrance: 1;
    in property <bool> sample: false;
    in-out property <bool> tools-open: false;
    spacing: 18px;
    if HostState.running && (root.tools-open || HostState.history-selected >= 0): Panel { height: 68px;
        Label { x: 21px; y: 17px; width: parent.width - 204px; height: 34px; text: "导入或分享战绩前，请暂停识别。"; wrap: word-wrap; color: Theme.muted; }
        Action { x: parent.width - 165px; y: 17px; width: 144px; height: 34px; label: "暂停识别"; description: "暂停并管理"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.command("toggle-running"); } }
    }
    Panel { height: HostState.history-note != "" ? 150px : 106px; entrance: root.entrance;
        SectionTitle { x: 21px; y: 17px; height: 26px; text: "海克斯大乱斗"; }
        HorizontalLayout { x: 21px; y: 56px; width: 330px; height: 34px; spacing: 10px;
            Action { primary: true; busy: HostState.history-busy; label: HostState.history-busy ? "正在读取…" : "刷新战绩"; enabled: HostState.connected && !HostState.busy && !HostState.history-busy && !HostState.offline && RecordState.import-count == 0; clicked => { HostState.command("history-refresh"); } }
            Action { label: "本地缓存"; enabled: HostState.connected && !HostState.busy && !HostState.history-busy && !HostState.offline && RecordState.import-count == 0; clicked => { HostState.command("history-cached"); } }
            if HostState.history-can-more: Action { label: "更多战绩"; enabled: HostState.connected && !HostState.busy && !HostState.history-busy && !HostState.offline && RecordState.import-count == 0; clicked => { HostState.command("history-more"); } }
        }
        if HostState.history-note != "": Label { x: 21px; y: 102px; width: parent.width - 42px; height: 34px; text: HostState.history-note; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
    }
    if RecordState.import-count > 0: Panel { height: 137px;
        SectionTitle { x: 21px; y: 17px; height: 25px; text: "导入预览 · 已选 " + RecordState.chosen-count + " / " + RecordState.import-count; }
        Label { x: 21px; y: 49px; width: parent.width - 42px; height: 30px; text: "仅导入预览中选中的记录。确认前再次核对当前账号与区服；取消不写入。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
        HorizontalLayout { x: 21px; y: 88px; width: 310px; height: 34px; spacing: 12px;
            Action { label: "取消导入"; enabled: !HostState.busy; clicked => { RecordState.action("cancel-import",0); } }
            Action { label: "确认导入所选"; enabled: !HostState.busy && RecordState.chosen-count > 0; primary: true; clicked => { RecordState.action("confirm-import",0); } }
        }
    }
    HorizontalLayout { height: 36px; spacing: 12px;
        LineEdit { accessible-label: "筛选英雄"; enabled: !RecordState.busy; text <=> HostState.history-query; placeholder-text: "筛选英雄"; edited(value) => { HostState.history-filter(value, HostState.history-result); } }
        ComboBox { accessible-label: "战绩结果"; enabled: !RecordState.busy; width: 130px; model: ["全部结果", "胜利", "失败", "重开"]; current-index <=> HostState.history-result; selected(value) => { HostState.history-filter(HostState.history-query, self.current-index); } }
    }
    if HostState.history.length == 0: Label { text: HostState.history-query != "" || HostState.history-result != 0 ? "调整筛选条件以查看战绩。" : HostState.offline ? "连接客户端后刷新战绩，或打开本地缓存。" : "刷新战绩，或打开本地缓存。"; height: 52px; wrap: word-wrap; color: Theme.muted; }
    for match[index] in HostState.history: Panel {
        height: (RecordState.import-count > 0 ? 154px : 118px) + (HostState.history-selected == index ? 196px + RecordLayout.content-height + (RecordLayout.content-height > 0px ? 12px : 0px) : 0px);
        Rectangle { x: 0px; y: 14px; width: 3px; height: 50px; border-radius: 1.5px; background: match.won ? Theme.green : match.result == "失败" ? Theme.red : Theme.muted; }
        Rectangle { x: 21px; y: 18px; width: 46px; height: 46px; background: Theme.background; border-width: 1px; border-color: Theme.stroke; border-radius: 4px;
            Image { source: match.icon; image-fit: contain; }
        }
        Label { x: 81px; y: 17px; width: parent.width - 380px; height: 28px; text: match.title; font-size: 16px; font-weight: 700; }
        Label { x: 81px; y: 49px; width: parent.width - 380px; height: 22px; text: match.duration; color: Theme.muted; font-size: 12px; }
        Rectangle { x: parent.width - 272px; y: 20px; width: 70px; height: 28px; border-radius: 5px; background: match.won ? #16362f : match.result == "失败" ? #39262d : #253340;
            Label { width: parent.width; height: parent.height; text: match.result; color: match.won ? Theme.green : match.result == "失败" ? Theme.red : Theme.muted; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
        }
        Label { x: parent.width - 184px; y: 15px; width: 163px; height: 32px; text: match.kda; font-size: 22px; font-weight: 700; horizontal-alignment: right; }
        Label { x: parent.width - 184px; y: 49px; width: 163px; height: 20px; text: "击杀 / 死亡 / 助攻"; font-size: 11px; color: Theme.muted; horizontal-alignment: right; }
        Label { x: 21px; y: 83px; width: parent.width - 180px; height: 22px; text: match.date; color: Theme.muted; font-size: 12px; }
        Action { x: parent.width - 135px; y: 77px; width: 114px; height: 28px; enabled: !RecordState.busy; label: HostState.history-selected == index ? "收起详情" : "查看详情"; clicked => { RecordState.action("select",index); } }
        if RecordState.import-count > 0: Action { x: 21px; y: 116px; width: 126px; height: 28px; label: match.chosen ? "已选 · 取消" : "选择导入"; primary: match.chosen; enabled: !HostState.busy; clicked => { RecordState.action("choose",index); } }
        if HostState.history-selected == index: Rectangle { y: RecordState.import-count > 0 ? 158px : 122px; height: 188px;
            Rectangle { x: 21px; y: 0px; width: parent.width - 42px; height: 1px; background: Theme.stroke; opacity: 0.55; }
            HorizontalLayout { x: 21px; y: 12px; height: 38px; width: 6 * 42px; spacing: 4px;
                for icon in match.items: Image { source: icon; width: 38px; height: 38px; image-fit: contain; }
            }
            HorizontalLayout { x: parent.width - 205px; y: 12px; height: 38px; width: 184px; spacing: 4px;
                for icon in match.augments: Image { source: icon; width: 38px; height: 38px; image-fit: contain; }
            }
            if match.detail != "": Label { x: 21px; y: 58px; width: parent.width - 42px; height: 82px; wrap: word-wrap; text: match.detail; color: Theme.muted; font-size: 12px; }
            if RecordState.import-count == 0: HorizontalLayout { x: 21px; y: 148px; width: 370px; height: 34px; spacing: 12px;
                Action { label: "匿名分享预览"; enabled: !HostState.busy && !HostState.running; clicked => { RecordState.action("share",index); } }
                Action { label: "导入本场观察"; enabled: !HostState.busy && !HostState.running && !HostState.offline; clicked => { RecordState.action("import-journal",index); } }
            }
        }
        if HostState.history-selected == index && RecordLayout.content-height > 0px: RecordDetails {
            x: 21px; y: (RecordState.import-count > 0 ? 154px : 118px) + 196px; width: parent.width - 42px;
        }
    }
    if HostState.history.length > 0 && HostState.history-pages > 1: HorizontalLayout { height: 36px; spacing: 12px;
        Action { label: "上一页"; enabled: !RecordState.busy && HostState.history-page > 0; clicked => { HostState.history-turn(-1); } }
        Label { text: (HostState.history-page + 1) + " / " + HostState.history-pages; horizontal-alignment: center; color: Theme.muted; }
        Action { label: "下一页"; enabled: !RecordState.busy && HostState.history-page + 1 < HostState.history-pages; clicked => { HostState.history-turn(1); } }
    }
    Action { label: root.tools-open ? "收起战绩管理" : "战绩管理"; clicked => { root.tools-open = !root.tools-open; } }
    if root.tools-open: VerticalLayout { spacing: 12px;
        Action { height: 34px; label: "选择旧战绩并预览"; enabled: HostState.connected && !HostState.busy && !HostState.history-busy && !HostState.running && !HostState.offline; clicked => { RecordState.action("import-history",0); } }
        Action { label: RecordState.unbound-open ? "收起未绑定本地观察" : "查看未绑定本地观察"; clicked => { RecordState.unbound-action("open", RecordState.unbound-open ? 0 : 1); } }
        if RecordState.unbound-open: VerticalLayout { spacing: 10px;
            Label { height: 60px; text: RecordState.unbound-note; wrap: word-wrap; color: Theme.muted; }
            if RecordState.unbound-names != "": Label { height: 42px; text: RecordState.unbound-names; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            for row[index] in RecordState.unbound: Panel { height: RecordState.unbound-selected == index ? (RecordState.unbound-pages > 1 ? 190px : 146px) + RecordState.unbound-events.length * 150px : 126px;
                SectionTitle { x: 21px; y: 12px; width: parent.width - 42px; height: 28px; text: row.title; font-size: 13px; }
                Label { x: 21px; y: 47px; width: parent.width - 42px; height: 25px; text: row.hint; color: Theme.muted; font-size: 12px; }
                Action { x: 21px; y: 81px; width: 150px; height: 32px; label: RecordState.unbound-selected == index ? "收起完整事件" : "查看完整事件"; clicked => { RecordState.unbound-action("select", index); } }
                if RecordState.unbound-selected == index: VerticalLayout { x: 21px; y: 136px; width: parent.width - 42px; spacing: 10px;
                    if RecordState.unbound-pages > 1: HorizontalLayout { height: 34px; spacing: 12px;
                        Action { label: "上一页"; enabled: RecordState.unbound-page > 0; clicked => { RecordState.unbound-action("page", -1); } }
                        Label { text: "第 " + (RecordState.unbound-page + 1) + " / " + RecordState.unbound-pages + " 页"; horizontal-alignment: center; }
                        Action { label: "下一页"; enabled: RecordState.unbound-page + 1 < RecordState.unbound-pages; clicked => { RecordState.unbound-action("page", 1); } }
                    }
                    for event in RecordState.unbound-events: Rectangle { height: 140px; background: Theme.background;
                        Label { x: 12px; y: 8px; width: parent.width - 24px; height: 24px; text: event.title; color: Theme.gold; font-size: 12px; }
                        Label { x: 12px; y: 37px; width: parent.width - 24px; height: 67px; text: event.cards; wrap: word-wrap; font-size: 12px; }
                        Label { x: 12px; y: 109px; width: parent.width - 24px; height: 24px; text: event.hint; color: Theme.muted; font-size: 12px; }
                    }
                }
            }
        }
    }
    if RecordState.journal-preview: RecordDetails { }
}
