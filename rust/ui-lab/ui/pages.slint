import { ComboBox, LineEdit } from "std-widgets.slint";
import { HostState, ShellState } from "host-state.slint";
import { Theme, Label, Action, Panel, SectionTitle, Disclosure, Toggle } from "components.slint";

export component SettingsPage inherits VerticalLayout {
    in-out property <bool> manual-open: false;
    spacing: 18px;
    Panel {
        height: 280px;
        Label { x: 23px; y: 21px; height: 20px; text: "软件更新"; color: Theme.gold; font-size: 15px; }
        Label { x: 23px; y: 56px; height: 30px; text: "当前版本 — · 尚未连接更新服务"; font-size: 19px; }
        Label { x: 23px; y: 100px; width: parent.width - 46px; height: 50px; wrap: word-wrap; text: "优先增量下载，缓存缺失或差分不可用时下载完整包。\n下载和安装均由你决定，不会退出游戏。"; color: Theme.muted; }
        HorizontalLayout { x: 23px; y: 164px; width: 240px; height: 38px; spacing: 10px;
            Action { label: "检查新版"; enabled: false; }
            Action { label: "发布记录"; enabled: false; }
        }
        Label { x: 23px; y: 224px; width: parent.width - 46px; height: 34px; wrap: word-wrap; text: "私有频道授权由现有 Rust 安全存储管理；此预览不读取或保存令牌。"; color: Theme.muted; font-size: 11px; }
    }
    Disclosure { label: "存储管理"; detail: "保留个人记录、设置、当前与回滚版本。\n连接宿主后先预览，再确认清理；离线预览不扫描文件。"; }
    Panel {
        height: HostState.preferences.length * 78px + 136px;
        VerticalLayout { x: 21px; y: 5px; width: parent.width - 42px; height: parent.height - 10px; spacing: 0px;
            for pref in HostState.preferences: Rectangle {
                height: 78px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.stroke; }
                Label { x: 0px; y: 11px; width: parent.width - 75px; height: 24px; text: pref.title; font-size: 13px; }
                Label { x: 0px; y: 38px; width: parent.width - 75px; height: 30px; wrap: word-wrap; text: ShellState.attached && pref.key == "pause_hotkey" ? ShellState.hotkey-hint : ShellState.attached && pref.key == "close_to_tray" ? ShellState.tray-hint : pref.hint; color: Theme.muted; font-size: 11px; }
                Toggle { x: parent.width - 44px; y: 24px; label: pref.title; checked: pref.checked; enabled: HostState.connected && !HostState.busy; toggled => { HostState.preference(pref.key, !pref.checked); } }
            }
            Rectangle { height: 62px;
                Label { x: 0px; y: 13px; width: parent.width - 250px; height: 30px; text: "识别后端"; }
                ComboBox { x: parent.width - 235px; y: 13px; width: 235px; height: 34px; model: ["自动选择（GPU 优先）", "CPU", "DirectML（GPU）"]; current-index <=> HostState.backend; enabled: HostState.connected && !HostState.busy; selected(value) => { HostState.backend-changed(self.current-index); } }
            }
            Rectangle { height: 62px;
                Label { x: 0px; y: 13px; width: parent.width - 250px; height: 30px; text: "界面与数据语言"; }
                ComboBox { x: parent.width - 235px; y: 13px; width: 235px; height: 34px; model: ["跟随客户端", "简体中文", "繁體中文", "English"]; current-index: HostState.locale; enabled: false; }
                // Locale activation stays disabled until all Slint strings are localized together.
            }
        }
    }
    Panel { height: 74px;
        Label { x: 21px; y: 12px; height: 23px; text: "浮窗显示"; color: Theme.blue; }
        Label { x: 21px; y: 38px; width: parent.width - 42px; height: 25px; text: "独占全屏可能遮住桌面浮窗，需要显示时可在游戏中自行选择无边框或窗口模式。"; wrap: word-wrap; color: Theme.muted; font-size: 11px; }
    }
    Panel { height: root.manual-open ? 430px : 300px;
        SectionTitle { x: 21px; y: 18px; height: 28px; text: "连接与诊断"; }
        Label { x: 21px; y: 58px; height: 24px; text: "自动识别并连接客户端"; }
        Label { x: 21px; y: 91px; width: parent.width - 42px; height: 38px; text: "登录后自动发现，无需选择安装目录。目录识别不等于通信成功，以实际连接状态为准。"; wrap: word-wrap; color: Theme.muted; font-size: 11px; }
        Label { x: 21px; y: 138px; height: 20px; text: "离线预览未访问客户端"; color: Theme.blue; font-size: 11px; }
        Action { x: 21px; y: 174px; width: parent.width - 42px; label: "高级回退：自动连接失败时手动指定目录"; clicked => { root.manual-open = !root.manual-open; } }
        if root.manual-open: VerticalLayout { x: 21px; y: 227px; width: parent.width - 42px; height: 155px; spacing: 12px;
            Label { text: "填写包含 LeagueClient.exe 的客户端目录；留空则仅使用自动发现。"; color: Theme.muted; height: 30px; }
            LineEdit { text <=> HostState.directory; enabled: HostState.connected && !HostState.busy; placeholder-text: "客户端目录"; height: 36px; }
            HorizontalLayout { height: 38px; spacing: 12px;
                Action { label: "保存目录"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.directory-save(HostState.directory); } }
                Action { label: "清除手动回退"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.directory-save(""); } }
            }
            Label { text: "保存失败会保留原设置，不会显示连接成功。"; color: Theme.muted; height: 25px; }
        }
    }
    Panel { height: 215px;
        SectionTitle { x: 21px; y: 18px; height: 28px; text: "领取轮次验证"; }
        Label { x: 21px; y: 58px; width: parent.width - 42px; height: 44px; text: "实际领取轮次尚未确认，继续使用整体胜率。\n刷新、属性碎片和锻造器额外选择不计为正式轮次。"; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout { x: 21px; y: 123px; width: 360px; height: 38px; spacing: 10px;
            Action { label: "打开本地日志"; enabled: false; }
            Action { label: "预览选人详情"; enabled: HostState.connected; clicked => { HostState.command("preview-champion"); } }
            Action { label: "检查一次"; enabled: false; }
        }
        Label { x: 21px; y: 176px; height: 23px; text: "实际领取轮次未确认，自动推荐继续使用整体胜率。"; color: Theme.muted; font-size: 11px; }
    }
}

export component HistoryPage inherits VerticalLayout {
    in property <bool> sample: false;
    spacing: 18px;
    Panel { height: 220px;
        SectionTitle { x: 21px; y: 18px; height: 26px; text: "海克斯大乱斗战绩"; }
        Label { x: 21px; y: 55px; width: parent.width - 42px; height: 24px; text: "自己的海克斯对局，优先显示本地记录；区服未确认时不猜测。"; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout { x: 21px; y: 98px; width: 330px; height: 38px; spacing: 10px;
            Action { label: "刷新战绩"; enabled: HostState.connected && !HostState.busy && !HostState.offline; clicked => { HostState.command("history-refresh"); } }
            Action { label: "本地缓存"; enabled: HostState.connected && !HostState.busy && !HostState.offline; clicked => { HostState.command("history-cached"); } }
            Action { label: "更多战绩"; enabled: HostState.connected && !HostState.busy && !HostState.offline; clicked => { HostState.command("history-more"); } }
        }
        Label { x: 21px; y: 160px; width: parent.width - 42px; height: 42px; text: HostState.history-note; wrap: word-wrap; color: Theme.yellow; }
    }
    HorizontalLayout { height: 36px; spacing: 12px;
        LineEdit { text <=> HostState.history-query; placeholder-text: "筛选英雄"; edited(value) => { HostState.history-filter(value, HostState.history-result); } }
        ComboBox { width: 130px; model: ["全部结果", "胜利", "失败", "重开"]; current-index <=> HostState.history-result; selected(value) => { HostState.history-filter(HostState.history-query, self.current-index); } }
    }
    if HostState.history.length == 0: Label { text: "暂无符合条件的战绩"; height: 42px; color: Theme.muted; }
    Disclosure { label: "本地选择记录 · 观察不等于领取"; detail: "按已确认账号与区服隔离。\n属性碎片、刷新及观察到的卡片都不证明实际领取。"; }
    for match[index] in HostState.history: Panel {
        height: HostState.history-selected == index ? 300px : 132px;
        SectionTitle { x: 21px; y: 17px; width: parent.width - 280px; height: 32px; text: match.title; }
        Label { x: 21px; y: 51px; height: 25px; text: "海克斯大乱斗 · " + match.duration; color: Theme.muted; }
        Label { x: parent.width - 260px; y: 23px; width: 75px; height: 30px; text: match.result; color: match.won ? Theme.green : Theme.red; font-size: 18px; }
        Label { x: parent.width - 170px; y: 23px; width: 150px; height: 30px; text: match.kda; font-size: 20px; }
        Action { x: 21px; y: 83px; width: 114px; height: 30px; label: HostState.history-selected == index ? "收起详情" : "查看详情"; clicked => { HostState.history-selected = HostState.history-selected == index ? -1 : index; } }
        if HostState.history-selected == index: Label { x: 21px; y: 137px; width: parent.width - 42px; height: 143px; wrap: word-wrap; text: match.detail; color: Theme.muted; }
    }
    HorizontalLayout { height: 38px; spacing: 12px;
        Action { label: "上一页"; enabled: HostState.history-page > 0; clicked => { HostState.history-turn(-1); } }
        Label { text: "第 " + (HostState.history-page + 1) + " / " + HostState.history-pages + " 页"; horizontal-alignment: center; }
        Action { label: "下一页"; enabled: HostState.history-page + 1 < HostState.history-pages; clicked => { HostState.history-turn(1); } }
    }
}
