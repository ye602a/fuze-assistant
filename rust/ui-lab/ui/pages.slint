import { MaintenancePage } from "maintenance.slint";
import { ComboBox, LineEdit } from "std-widgets.slint";
import { HostState, ShellState, RecordState, DiagnosticState } from "host-state.slint";
import { RecordDetails } from "records.slint";
import { Theme, Label, Action, Panel, SectionTitle, Toggle, Tabs } from "components.slint";

export component SettingsPage inherits VerticalLayout {
    in property <float> entrance: 1;
    in-out property <int> section: 0;
    in-out property <bool> migration-open: false;
    in-out property <bool> manual-open: false;
    in-out property <bool> feedback-open: false;
    spacing: 16px;
    Tabs { labels: ["常用设置", "数据与更新", "帮助与反馈"]; current <=> root.section; }
    if root.section == 0: VerticalLayout { spacing: 16px;
        Panel {
            height: HostState.preferences.length * 68px + 120px;
            SectionTitle { x: 21px; y: 14px; height: 26px; text: "识别与显示偏好"; }
            VerticalLayout { x: 21px; y: 48px; width: parent.width - 42px; height: parent.height - 58px; spacing: 0px;
                for pref in HostState.preferences: Rectangle {
                    height: 68px;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.stroke; }
                    Label { x: 0px; y: 5px; width: parent.width - 75px; height: 24px; text: pref.title; font-size: 13px; }
                    Label { x: 0px; y: 29px; width: parent.width - 75px; height: 30px; wrap: word-wrap; text: ShellState.attached && pref.key == "pause_hotkey" ? ShellState.hotkey-hint : ShellState.attached && pref.key == "close_to_tray" ? ShellState.tray-hint : pref.hint; color: Theme.muted; font-size: 12px; }
                    Toggle { x: parent.width - 44px; y: 20px; label: pref.title; checked: pref.checked; enabled: HostState.connected && !HostState.busy; toggled => { HostState.preference(pref.key, !pref.checked); } }
                }
                Rectangle { height: 62px;
                    Label { x: 0px; y: 13px; width: parent.width - 250px; height: 30px; text: "识别后端"; }
                    ComboBox { accessible-label: "识别后端"; x: parent.width - 235px; y: 13px; width: 235px; height: 34px; model: ["自动选择（GPU 优先）", "CPU", "DirectML（GPU）"]; current-index <=> HostState.backend; enabled: HostState.connected && !HostState.busy; selected(value) => { HostState.backend-changed(self.current-index); } }
                }
            }
        }
        Panel { height: 119px;
            Label { x: 21px; y: 12px; height: 23px; text: "浮窗显示"; color: Theme.blue; }
            Label { x: 21px; y: 38px; width: parent.width - 42px; height: 25px; text: "独占全屏可能遮住桌面浮窗，需要显示时可在游戏中自行选择无边框或窗口模式。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            Action { x: 21px; y: 76px; width: 175px; height: 30px; label: "重新打开局内资料"; enabled: HostState.connected; clicked => { HostState.command("show-reference"); } }
        }
        Panel { height: root.manual-open ? 418px : 236px;
            SectionTitle { x: 21px; y: 18px; height: 28px; text: "连接与诊断"; }
            Label { x: 21px; y: 58px; height: 24px; text: "自动识别并连接客户端"; }
            Label { x: 21px; y: 91px; width: parent.width - 42px; height: 38px; text: "登录后自动发现，无需选择安装目录。目录识别不等于通信成功，以实际连接状态为准。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            Label { x: 21px; y: 138px; width: parent.width - 42px; height: 20px; text: HostState.offline ? "离线预览未访问客户端" : HostState.connection-value + " · " + HostState.verified; color: Theme.blue; font-size: 12px; }
            Action { x: 21px; y: 174px; width: parent.width - 42px; label: "高级回退：自动连接失败时手动指定目录"; clicked => { root.manual-open = !root.manual-open; } }
            if root.manual-open: VerticalLayout { x: 21px; y: 222px; width: parent.width - 42px; height: 176px; spacing: 12px;
                Label { text: "填写包含 LeagueClient.exe 的客户端目录；留空则仅使用自动发现。"; color: Theme.muted; height: 30px; }
                LineEdit { accessible-label: "客户端目录"; text <=> HostState.directory; enabled: HostState.connected && !HostState.busy; placeholder-text: "客户端目录"; height: 36px; }
                HorizontalLayout { height: 38px; spacing: 12px;
                    Action { busy: HostState.pending-action == "directory"; label: HostState.pending-action == "directory" ? "正在保存…" : "保存目录"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.directory-save(HostState.directory); } }
                    Action { label: "清除手动回退"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.directory-save(""); } }
                }
                Label { text: "保存失败会保留原设置，不会显示连接成功。"; color: Theme.muted; height: 25px; }
            }
        }
    }
    if root.section == 1: VerticalLayout { spacing: 16px;
        if HostState.running: Panel { height: 90px;
            Label { x: 21px; y: 14px; width: parent.width - 212px; height: 58px; text: "识别正在运行，可以检查新版。安装更新、清理和导入需要先暂停。"; wrap: word-wrap; color: Theme.muted; }
            Action { x: parent.width - 165px; y: 25px; width: 144px; label: "暂停并管理"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.command("toggle-running"); } }
        }
        Panel { height: 206px;
            SectionTitle { x: 21px; y: 17px; height: 25px; text: "推荐数据"; }
            Label { x: 21px; y: 50px; width: parent.width - 42px; height: 46px; text: HostState.data-compatibility; wrap: word-wrap; color: HostState.data-mismatch ? Theme.gold : Theme.blue; font-size: 12px; }
            Label { x: 21px; y: 103px; width: parent.width - 42px; height: 42px; text: HostState.data-progress; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            if HostState.data-total > 0: Rectangle { x: 21px; y: 150px; width: parent.width - 42px; height: 4px; background: Theme.stroke;
                Rectangle { width: parent.width * HostState.data-completed / max(1, HostState.data-total); height: parent.height; background: Theme.blue; }
            }
            Action { x: 21px; y: 163px; width: 180px; height: 30px; busy: HostState.pending-action == "data-update"; label: HostState.pending-action == "data-update" ? "正在更新数据…" : "检查数据更新"; enabled: HostState.connected && !HostState.offline && !HostState.running && !HostState.busy; clicked => { HostState.command("data-update"); } }
        }
        MaintenancePage { entrance: root.entrance; }
        Action { label: root.migration-open ? "收起旧设置迁移" : "旧设置迁移"; clicked => { root.migration-open = !root.migration-open; } }
        if root.migration-open: Panel { height: 130px;
            SectionTitle { x: 21px; y: 17px; height: 25px; text: "迁移旧版偏好"; }
            Label { x: 21px; y: 51px; width: parent.width - 42px; height: 27px; text: "只读取你选择的旧配置；预览确认后导入受支持偏好，保留当前语言与启动状态。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            Action { x: 21px; y: 88px; width: 165px; height: 30px; label: "选择旧设置并预览"; enabled: HostState.connected && !HostState.busy && !HostState.running && !HostState.offline; clicked => { RecordState.action("import-settings",0); } }
        }
    }
    if root.section == 2: VerticalLayout { spacing: 16px;
        Panel { height: 326px + (DiagnosticState.open ? DiagnosticState.rows.length * 60px : 0px);
            SectionTitle { x: 21px; y: 18px; height: 28px; text: "运行状态与反馈"; }
            Label { x: 21px; y: 58px; width: parent.width - 42px; height: 40px; text: DiagnosticState.summary; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            HorizontalLayout { x: 21px; y: 108px; width: parent.width - 42px; height: 36px; spacing: 12px;
                Action { label: DiagnosticState.open ? "收起最近状态" : "查看最近状态"; clicked => { DiagnosticState.open = !DiagnosticState.open; } }
                Action { busy: DiagnosticState.busy; label: DiagnosticState.busy ? "正在导出…" : "导出脱敏反馈"; enabled: HostState.connected && !HostState.running && !HostState.busy && !DiagnosticState.busy; clicked => { DiagnosticState.action("export"); } }
            }
            Label { x: 21px; y: 156px; width: parent.width - 42px; height: 48px; text: DiagnosticState.log-status; wrap: word-wrap; color: DiagnosticState.log-retry ? Theme.blue : Theme.muted; font-size: 12px; }
            HorizontalLayout { x: 21px; y: 207px; width: parent.width - 42px; height: 32px; spacing: 12px;
                Action { label: "打开日志目录"; enabled: HostState.connected && !HostState.offline; clicked => { DiagnosticState.action("open-logs"); } }
                Action { label: "重试日志"; enabled: DiagnosticState.log-retry && !DiagnosticState.busy; clicked => { DiagnosticState.action("retry-log"); } }
            }
            Label { x: 21px; y: 250px; width: parent.width - 42px; height: 60px; text: "连接、画面与识别状态保存在本地。导出反馈前请暂停识别；导出的文件不会自动上传。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            if DiagnosticState.open: VerticalLayout { x: 21px; y: 318px; width: parent.width - 42px; height: DiagnosticState.rows.length * 60px;
                for row in DiagnosticState.rows: Label { height: 60px; text: row; wrap: word-wrap; color: Theme.blue; font-size: 12px; }
            }
        }
        Action { label: root.feedback-open ? "收起公开诊断反馈" : "展开公开诊断反馈"; clicked => { root.feedback-open = !root.feedback-open; } }
        if root.feedback-open: Panel { height: 540px + (DiagnosticState.upload-confirm ? 100px : 0px);
            SectionTitle { x: 21px; y: 18px; height: 28px; text: "GitHub 公开诊断反馈"; }
            Label { x: 21px; y: 58px; width: parent.width - 110px; height: 38px; text: "每局赛后上传 · 首次故障提前反馈"; wrap: word-wrap; }
            Toggle { x: parent.width - 65px; y: 62px; label: "每局自动上传到公开 Issues"; checked: DiagnosticState.upload-enabled; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; toggled => { DiagnosticState.upload-action("toggle"); } }
            Label { x: 21px; y: 103px; width: parent.width - 42px; height: 40px; text: DiagnosticState.upload-tracking; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            Label { x: 21px; y: 149px; width: parent.width - 42px; height: 54px; text: DiagnosticState.upload-status; wrap: word-wrap; color: Theme.blue; font-size: 12px; }
            Label { x: 21px; y: 209px; width: parent.width - 42px; height: 40px; text: DiagnosticState.upload-authorization; wrap: word-wrap; color: Theme.gold; font-size: 12px; }
            HorizontalLayout { x: 21px; y: 263px; width: parent.width - 42px; height: 36px; spacing: 10px;
                Action { label: "获取上传令牌"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("help"); } }
                Action { label: "配置上传令牌"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("configure"); } }
                Action { label: DiagnosticState.upload-busy ? "正在验证…" : "验证授权"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("verify"); } }
            }
            HorizontalLayout { x: 21px; y: 311px; width: parent.width - 42px; height: 36px; spacing: 10px;
                Action { label: "补传最近对局"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy && !HostState.running; clicked => { DiagnosticState.upload-confirm = true; } }
                Action { label: "重试待传报告"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("retry"); } }
                Action { label: "查看报告"; enabled: DiagnosticState.upload-has-report; clicked => { DiagnosticState.upload-action("open"); } }
            }
            Action { x: 21px; y: 359px; width: 170px; label: "删除上传令牌"; enabled: DiagnosticState.upload-ready && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-action("remove"); } }
            Label { x: 21px; y: 404px; width: parent.width - 42px; height: 48px; text: DiagnosticState.upload-notice; wrap: word-wrap; font-size: 12px; color: Theme.gold; }
            Label { x: 21px; y: 461px; width: parent.width - 42px; height: 66px; text: "报告公开在 ye602a/fuze-assistant 的 Issues。仅上传状态、耗时、计数和卡位分类，不含截图、账号、路径、OCR 原文或密钥。\n更新下载免令牌；反馈写入仍需 Issues 读写授权。暂停后可补传有限日志中的最近对局。"; wrap: word-wrap; font-size: 12px; color: Theme.muted; }
            if DiagnosticState.upload-confirm: Rectangle { x: 21px; y: 535px; width: parent.width - 42px; height: 88px; background: transparent;
                Label { x: 0px; y: 0px; width: parent.width; height: 38px; text: "将从本地有限日志生成最近对局摘要并公开上传；可能不完整，不会上传原始日志。"; wrap: word-wrap; font-size: 12px; }
                HorizontalLayout { y: 46px; width: parent.width; height: 34px; spacing: 10px;
                    Action { label: "取消"; clicked => { DiagnosticState.upload-confirm = false; } }
                    Action { primary: true; label: "确认公开补传"; enabled: !HostState.running && !DiagnosticState.upload-busy; clicked => { DiagnosticState.upload-confirm = false; DiagnosticState.upload-action("recover"); } }
                }
            }
        }
    }
}

export component HistoryPage inherits VerticalLayout {
    in property <float> entrance: 1;
    in property <bool> sample: false;
    in-out property <bool> tools-open: false;
    spacing: 18px;
    if HostState.running: Panel { height: 90px;
        Label { x: 21px; y: 14px; width: parent.width - 212px; height: 58px; text: "识别正在运行，查看缓存无需暂停；大厅可后台刷新战绩。导入和分享仍需先暂停。"; wrap: word-wrap; color: Theme.muted; }
        Action { x: parent.width - 165px; y: 25px; width: 144px; label: "暂停并管理"; enabled: HostState.connected && !HostState.busy; clicked => { HostState.command("toggle-running"); } }
    }
    Panel { height: 192px; entrance: root.entrance;
        SectionTitle { x: 21px; y: 18px; height: 26px; text: "海克斯大乱斗战绩"; }
        Label { x: 21px; y: 55px; width: parent.width - 42px; height: 24px; text: "自己的海克斯对局，优先显示本地记录；区服未确认时不猜测。"; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout { x: 21px; y: 98px; width: 330px; height: 38px; spacing: 10px;
            Action { primary: true; busy: HostState.history-busy; label: HostState.history-busy ? "正在读取…" : "刷新战绩"; enabled: HostState.connected && !HostState.busy && !HostState.history-busy && !HostState.offline && RecordState.import-count == 0; clicked => { HostState.command("history-refresh"); } }
            Action { label: "本地缓存"; enabled: HostState.connected && !HostState.busy && !HostState.history-busy && !HostState.offline && RecordState.import-count == 0; clicked => { HostState.command("history-cached"); } }
            Action { label: "更多战绩"; enabled: HostState.connected && !HostState.busy && !HostState.history-busy && !HostState.offline && HostState.history-can-more && RecordState.import-count == 0; clicked => { HostState.command("history-more"); } }
        }
        Label { x: 21px; y: 144px; width: parent.width - 42px; height: 42px; text: HostState.history-note; wrap: word-wrap; color: Theme.yellow; }
    }
    if RecordState.import-count > 0: Panel { height: 137px;
        SectionTitle { x: 21px; y: 17px; height: 25px; text: "导入预览 · 已选 " + RecordState.chosen-count + " / " + RecordState.import-count; }
        Label { x: 21px; y: 49px; width: parent.width - 42px; height: 30px; text: "仅导入预览中选中的记录。确认前再次核对当前账号与区服；取消不写入。"; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
        HorizontalLayout { x: 21px; y: 88px; width: 310px; height: 34px; spacing: 12px;
            Action { label: "取消导入"; enabled: !HostState.busy; clicked => { RecordState.action("cancel-import",0); } }
            Action { label: "确认导入所选"; enabled: !HostState.busy && RecordState.chosen-count > 0; primary: true; clicked => { RecordState.action("confirm-import",0); } }
        }
    }
    HorizontalLayout { height: 36px; spacing: 12px;
        LineEdit { accessible-label: "筛选英雄"; enabled: !RecordState.busy; text <=> HostState.history-query; placeholder-text: "筛选英雄"; edited(value) => { HostState.history-filter(value, HostState.history-result); } }
        ComboBox { accessible-label: "战绩结果"; enabled: !RecordState.busy; width: 130px; model: ["全部结果", "胜利", "失败", "重开"]; current-index <=> HostState.history-result; selected(value) => { HostState.history-filter(HostState.history-query, self.current-index); } }
    }
    if HostState.history.length == 0: Label { text: HostState.history-query != "" || HostState.history-result != 0 ? "暂无符合条件的战绩，试试清除筛选。" : HostState.offline ? "离线预览不读取个人战绩。连接客户端后，可刷新战绩或查看本地缓存。" : "暂无可显示的战绩。可刷新战绩或查看本地缓存。"; height: 52px; wrap: word-wrap; color: Theme.muted; }
    for match[index] in HostState.history: Panel {
        height: HostState.history-selected == index ? 374px + 165px + RecordState.observations.length * 90px + (RecordState.share-ready ? 623px : 0px) : 146px;
        Rectangle { x: 21px; y: 18px; width: 48px; height: 48px; background: Theme.background; border-width: 1px; border-color: Theme.stroke;
            Image { source: match.icon; image-fit: contain; }
        }
        SectionTitle { x: 82px; y: 17px; width: parent.width - 350px; height: 32px; text: match.title; }
        Label { x: 82px; y: 51px; height: 25px; text: "海克斯大乱斗 · " + match.duration; color: Theme.muted; }
        Label { x: parent.width - 260px; y: 23px; width: 75px; height: 30px; text: match.result; color: match.won ? Theme.green : Theme.red; font-size: 18px; }
        Label { x: parent.width - 170px; y: 23px; width: 150px; height: 30px; text: match.kda; font-size: 20px; }
        Label { x: 21px; y: 86px; height: 20px; text: match.date; color: Theme.muted; font-size: 12px; }
        Action { x: parent.width - 135px; y: 100px; width: 114px; height: 30px; enabled: !RecordState.busy; label: HostState.history-selected == index ? "收起详情" : "查看详情"; clicked => { RecordState.action("select",index); } }
        if RecordState.import-count > 0: Action { x: 21px; y: 110px; width: 110px; height: 28px; label: match.chosen ? "已选 · 点击取消" : "选择导入"; primary: match.chosen; enabled: !HostState.busy; clicked => { RecordState.action("choose",index); } }
        if HostState.history-selected == index: Rectangle { y: 151px; height: 190px;
            HorizontalLayout { x: 21px; y: 0px; height: 38px; width: 6 * 42px; spacing: 4px;
                for icon in match.items: Image { source: icon; width: 38px; height: 38px; image-fit: contain; }
            }
            HorizontalLayout { x: parent.width - 205px; y: 0px; height: 38px; width: 184px; spacing: 4px;
                for icon in match.augments: Image { source: icon; width: 38px; height: 38px; image-fit: contain; }
            }
            Label { x: 21px; y: 49px; width: parent.width - 42px; height: 88px; wrap: word-wrap; text: match.detail; color: Theme.muted; }
            if RecordState.import-count == 0: HorizontalLayout { x: 21px; y: 149px; width: 370px; height: 34px; spacing: 12px;
                Action { label: "生成匿名分享预览"; enabled: !HostState.busy && !HostState.running; clicked => { RecordState.action("share",index); } }
                Action { label: "导入本场旧观察记录"; enabled: !HostState.busy && !HostState.running && !HostState.offline; clicked => { RecordState.action("import-journal",index); } }
            }
        }
        if HostState.history-selected == index: RecordDetails {
            x: 21px; y: 356px; width: parent.width - 42px;
            height: 165px + RecordState.observations.length * 90px + (RecordState.share-ready ? 623px : 0px);
        }
    }
    if HostState.history.length > 0: HorizontalLayout { height: 38px; spacing: 12px;
        Action { label: "上一页"; enabled: !RecordState.busy && HostState.history-page > 0; clicked => { HostState.history-turn(-1); } }
        Label { text: "第 " + (HostState.history-page + 1) + " / " + HostState.history-pages + " 页"; horizontal-alignment: center; }
        Action { label: "下一页"; enabled: !RecordState.busy && HostState.history-page + 1 < HostState.history-pages; clicked => { HostState.history-turn(1); } }
    }
    Action { label: root.tools-open ? "收起战绩管理" : "战绩管理"; clicked => { root.tools-open = !root.tools-open; } }
    if root.tools-open: VerticalLayout { spacing: 12px;
        Action { height: 34px; label: "选择旧战绩并预览"; enabled: HostState.connected && !HostState.busy && !HostState.history-busy && !HostState.running && !HostState.offline; clicked => { RecordState.action("import-history",0); } }
        Action { label: RecordState.unbound-open ? "收起未绑定本地观察" : "查看未绑定本地观察"; clicked => { RecordState.unbound-action("open", RecordState.unbound-open ? 0 : 1); } }
        if RecordState.unbound-open: VerticalLayout { spacing: 10px;
            Label { height: 60px; text: RecordState.unbound-note; wrap: word-wrap; color: Theme.muted; }
            if RecordState.unbound.length == 0: Label { height: 36px; text: "暂无未绑定的本机观察记录"; color: Theme.muted; }
            Label { height: 42px; text: RecordState.unbound-names; wrap: word-wrap; color: Theme.muted; font-size: 12px; }
            for row[index] in RecordState.unbound: Panel { height: RecordState.unbound-selected == index ? 190px + RecordState.unbound-events.length * 150px : 126px;
                SectionTitle { x: 21px; y: 12px; width: parent.width - 42px; height: 28px; text: row.title; font-size: 13px; }
                Label { x: 21px; y: 47px; width: parent.width - 42px; height: 25px; text: row.hint; color: Theme.muted; font-size: 12px; }
                Action { x: 21px; y: 81px; width: 150px; height: 32px; label: RecordState.unbound-selected == index ? "收起完整事件" : "查看完整事件"; clicked => { RecordState.unbound-action("select", index); } }
                if RecordState.unbound-selected == index: VerticalLayout { x: 21px; y: 136px; width: parent.width - 42px; spacing: 10px;
                    HorizontalLayout { height: 34px; spacing: 12px;
                        Action { label: "上一页"; enabled: RecordState.unbound-page > 0; clicked => { RecordState.unbound-action("page", -1); } }
                        Label { text: "第 " + (RecordState.unbound-page + 1) + " / " + RecordState.unbound-pages + " 页"; horizontal-alignment: center; }
                        Action { label: "下一页"; enabled: RecordState.unbound-page + 1 < RecordState.unbound-pages; clicked => { RecordState.unbound-action("page", 1); } }
                    }
                    for event in RecordState.unbound-events: Rectangle { height: 140px; background: Theme.background;
                        Label { x: 12px; y: 8px; width: parent.width - 24px; height: 24px; text: event.title; color: Theme.gold; font-size: 12px; }
                        Label { x: 12px; y: 37px; width: parent.width - 24px; height: 67px; text: event.cards; wrap: word-wrap; font-size: 12px; }
                        Label { x: 12px; y: 109px; width: parent.width - 24px; height: 24px; text: event.hint; color: Theme.muted; font-size: 12px; }
                    }
                }
            }
        }
    }
    if RecordState.journal-preview: RecordDetails { }
}
